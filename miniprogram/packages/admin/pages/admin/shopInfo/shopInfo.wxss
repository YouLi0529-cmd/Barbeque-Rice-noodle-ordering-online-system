.shop-info-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #FFF7EC;
  color: #3A2418;
  box-sizing: border-box;
}

.top-bar {
  flex: none;
  height: 58rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(154, 100, 42, 0.16);
  box-sizing: border-box;
}

.page-title {
  font-size: 23rpx;
  font-weight: 900;
}

.back-btn {
  min-width: 70rpx;
  height: 32rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #FFF1DC;
  color: #9A642A;
  font-size: 14rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.settings-content {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 52rpx;
  padding: 26rpx 48rpx;
  box-sizing: border-box;
}

.form-section {
  width: 300rpx;
}

.form-label {
  margin-bottom: 13rpx;
  color: #6B4B34;
  font-size: 16rpx;
  font-weight: 800;
}

.phone-input {
  width: 100%;
  height: 66rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(154, 100, 42, 0.25);
  border-radius: 8rpx;
  background: #FFFFFF;
  color: #3A2418;
  font-size: 18rpx;
  box-sizing: border-box;
}

.image-picker {
  width: 190rpx;
  height: 190rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1rpx dashed rgba(154, 100, 42, 0.42);
  border-radius: 8rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.image-picker-pressed {
  opacity: 0.72;
}

.contact-image {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  color: #9A642A;
  font-size: 15rpx;
  font-weight: 800;
}

.bottom-bar {
  flex: none;
  padding: 10rpx 22rpx 18rpx;
  display: flex;
  justify-content: flex-end;
  border-top: 1rpx solid rgba(154, 100, 42, 0.12);
  box-sizing: border-box;
}

.save-btn {
  width: 126rpx;
  height: 42rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #F1C46B;
  color: #3A2418;
  font-size: 16rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.save-btn[disabled] {
  opacity: 0.55;
}
