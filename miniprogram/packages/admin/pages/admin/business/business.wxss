page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #FFF7EC;
}

.business-page {
  width: 100vw;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  color: #3A2418;
  background: #FFF7EC;
}

.business-head {
  height: 48rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(58, 36, 24, 0.1);
  background: #FFF7EC;
}

.business-title {
  font-size: 17rpx;
  font-weight: 900;
}

.business-refresh {
  min-width: 48rpx;
  height: 26rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(58, 36, 24, 0.22);
  border-radius: 5rpx;
  color: #6A4530;
  font-size: 10rpx;
  font-weight: 800;
}

.business-scroll {
  height: calc(100vh - 48rpx);
  box-sizing: border-box;
}

.business-summary {
  padding: 16rpx 24rpx 12rpx;
  display: grid;
  grid-template-columns: minmax(0, 2.3fr) minmax(110rpx, 1fr);
  gap: 14rpx;
  box-sizing: border-box;
}

.summary-card {
  min-height: 104rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(58, 36, 24, 0.15);
  border-radius: 7rpx;
  box-shadow: 0 5rpx 12rpx rgba(74, 41, 22, 0.11);
  background: #FFFFFF;
}

.revenue-card {
  background: #FFFDF8;
}

.table-card {
  background: #FFF4D9;
}

.summary-head {
  min-height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.summary-label,
.dish-section-title {
  flex: none;
  color: #70472E;
  font-size: 11rpx;
  font-weight: 900;
}

.range-scroll {
  width: 250rpx;
  flex: none;
  white-space: nowrap;
}

.range-row {
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
  padding-right: 2rpx;
}

.range-option {
  height: 22rpx;
  padding: 0 8rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(58, 36, 24, 0.16);
  border-radius: 4rpx;
  color: #7B5946;
  background: rgba(255, 255, 255, 0.72);
  font-size: 9rpx;
  font-weight: 800;
}

.range-option.active {
  border-color: #C9341C;
  color: #FFFFFF;
  background: #C9341C;
}

.revenue-value {
  margin-top: 14rpx;
  color: #BE351D;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 900;
}

.money-symbol {
  margin-right: 4rpx;
  font-size: 16rpx;
}

.table-value {
  margin-top: 24rpx;
  color: #5B351B;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 900;
}

.dish-section {
  margin: 0 24rpx 22rpx;
  padding: 14rpx 16rpx 16rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(58, 36, 24, 0.14);
  border-radius: 7rpx;
  background: #FFFFFF;
}

.dish-section-head {
  min-height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.dish-range-scroll {
  width: 250rpx;
}

.dish-table {
  margin-top: 10rpx;
  overflow: hidden;
  border: 1rpx solid rgba(58, 36, 24, 0.12);
  border-radius: 5rpx;
}

.dish-row {
  min-height: 34rpx;
  display: grid;
  grid-template-columns: 30rpx minmax(150rpx, 2.4fr) minmax(84rpx, 1fr) 62rpx 90rpx;
  align-items: center;
  border-bottom: 1rpx solid rgba(58, 36, 24, 0.08);
  font-size: 10rpx;
}

.dish-row:last-child {
  border-bottom: 0;
}

.dish-row-head {
  min-height: 30rpx;
  color: #7A5945;
  background: #FFF6E7;
  font-size: 9rpx;
  font-weight: 900;
}

.dish-rank,
.dish-quantity,
.dish-amount {
  text-align: center;
}

.dish-name,
.dish-category {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-name {
  padding-right: 8rpx;
  color: #3A2418;
  font-weight: 800;
}

.dish-category {
  padding-right: 8rpx;
  color: #8B6B58;
}

.dish-amount {
  padding-right: 10rpx;
  box-sizing: border-box;
  color: #BE351D;
  font-weight: 900;
}

.stats-empty,
.stats-error,
.stats-note {
  min-height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #947A6B;
  font-size: 11rpx;
}

.stats-error {
  min-height: auto;
  justify-content: flex-start;
  color: #C9341C;
}

.stats-note {
  min-height: auto;
  padding-top: 8rpx;
  justify-content: flex-start;
  color: #9B6A32;
  font-size: 9rpx;
}

@media (max-width: 600px) {
  .business-summary {
    grid-template-columns: minmax(0, 1.7fr) minmax(90rpx, 1fr);
    gap: 9rpx;
    padding: 12rpx 14rpx 9rpx;
  }

  .dish-section {
    margin: 0 14rpx 16rpx;
  }

  .range-scroll,
  .dish-range-scroll {
    width: 190rpx;
  }

  .dish-row {
    grid-template-columns: 26rpx minmax(100rpx, 2fr) minmax(56rpx, 0.8fr) 44rpx 66rpx;
    font-size: 9rpx;
  }
}
