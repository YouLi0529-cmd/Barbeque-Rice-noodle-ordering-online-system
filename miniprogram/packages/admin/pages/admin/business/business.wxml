<view class="business-page" capture-bind:tap="onAdminTap">
  <view class="business-head">
    <view class="business-title">{{ui.title}}</view>
    <view class="business-refresh" bindtap="refreshStats">{{refreshing ? '...' : ui.refresh}}</view>
  </view>

  <scroll-view class="business-scroll" scroll-y enable-flex>
    <view class="business-summary">
      <view class="summary-card revenue-card">
        <view class="summary-head">
          <view class="summary-label">{{ui.revenue}}</view>
          <view class="range-control">
            <view
              wx:for="{{rangeOptions}}"
              wx:key="key"
              class="range-option {{revenueRange === item.key ? 'active' : ''}}"
              data-value="{{item.key}}"
              bindtap="selectRevenueRange">{{item.label}}</view>
          </view>
        </view>
        <view class="revenue-value"><text class="money-symbol">{{ui.currency}}</text>{{revenueText}}</view>
      </view>

      <view class="summary-card table-card">
        <view class="summary-label">{{ui.settledTables}}</view>
        <view class="table-value">{{settledTableCount}}</view>
      </view>

      <view class="summary-card arrival-card">
        <view class="summary-label">{{ui.arrivalPeople}}</view>
        <view class="arrival-value">{{arrivalPeopleCount}}<text class="arrival-unit">{{ui.peopleUnit}}</text></view>
      </view>
    </view>

    <view class="dish-section">
      <view class="dish-section-head">
        <view class="dish-section-title">{{ui.dishSales}}</view>
        <view class="dish-filter-controls">
          <view class="dish-sort-control">
            <view
              wx:for="{{dishSortOptions}}"
              wx:key="key"
              class="dish-sort-option {{dishSort === item.key ? 'active' : ''}}"
              data-value="{{item.key}}"
              bindtap="selectDishSort">{{item.label}}</view>
          </view>
          <view class="range-control dish-range-control">
            <view
              wx:for="{{rangeOptions}}"
              wx:key="key"
              class="range-option {{dishRange === item.key ? 'active' : ''}}"
              data-value="{{item.key}}"
              bindtap="selectDishRange">{{item.label}}</view>
          </view>
        </view>
      </view>

      <view class="dish-search-wrap">
        <input
          class="dish-search-input"
          type="text"
          value="{{dishSearch}}"
          placeholder="{{ui.searchDish}}"
          placeholder-class="dish-search-placeholder"
          bindinput="onDishSearchInput" />
      </view>

      <view class="dish-table" wx:if="{{dishList.length > 0}}">
        <view class="dish-row dish-row-head">
          <view class="dish-rank"></view>
          <view class="dish-name">{{ui.dish}}</view>
          <view class="dish-category">{{ui.category}}</view>
          <view class="dish-quantity">{{ui.soldQuantity}}</view>
          <view class="dish-amount">{{ui.salesAmount}}</view>
        </view>
        <view class="dish-row" wx:for="{{dishList}}" wx:key="id">
          <view class="dish-rank">{{item.rank}}</view>
          <view class="dish-name">{{item.name}}</view>
          <view class="dish-category">{{item.categoryText}}</view>
          <view class="dish-quantity">{{item.quantityText}}</view>
          <view class="dish-amount">{{ui.currency}}{{item.salesAmountText}}</view>
        </view>
      </view>
      <view class="stats-empty" wx:else>{{loading ? '...' : (dishSearch ? ui.searchEmpty : ui.empty)}}</view>
      <view class="stats-note" wx:if="{{isTruncated}}">{{ui.truncated}}</view>
      <view class="stats-error" wx:if="{{loadError}}">{{loadError}}</view>
    </view>
  </scroll-view>

  <admin-info-center id="admin-info-center"></admin-info-center>
</view>
