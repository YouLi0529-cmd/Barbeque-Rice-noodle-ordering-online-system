.print-page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #fff7ec;
  color: #3a2418;
}

.page-head {
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(58, 36, 24, 0.1);
  background: #fff7ec;
}

.page-title {
  margin: 0;
  color: #3a2418;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.outline-btn,
.primary-btn,
.primary-small,
.small-btn,
.search-btn,
.filter-toggle,
.text-link {
  font-weight: 800;
  text-align: center;
}

.tab-scroll,
.template-tabs {
  width: 100%;
  white-space: nowrap;
  background: #fff7ec;
}

.tabs {
  display: inline-flex;
  gap: 12rpx;
  padding: 18rpx 24rpx;
}

.tab,
.template-tab {
  display: inline-block;
  flex-shrink: 0;
  padding: 15rpx 22rpx;
  border-radius: 8rpx;
  color: #826456;
  background: #fff0da;
  font-size: 24rpx;
  font-weight: 800;
}

.tab.active,
.template-tab.active {
  color: #fffaf4;
  background: #e54a1d;
}

.loading-bar {
  padding: 14rpx 24rpx;
  color: #9b6837;
  background: #fff0da;
  font-size: 23rpx;
  text-align: center;
}

.backend-error {
  margin: 18rpx 24rpx 0;
  padding: 22rpx;
  border: 1rpx solid #efb4a4;
  border-radius: 8rpx;
  color: #7f3224;
  background: #fff0eb;
}

.backend-error-title {
  color: #6d2418;
  font-size: 27rpx;
  font-weight: 900;
}

.backend-error-message {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.backend-retry {
  display: inline-block;
  margin-top: 16rpx;
  padding: 9rpx 16rpx;
  border-radius: 6rpx;
  color: #fffaf4;
  background: #c94132;
  font-size: 22rpx;
  font-weight: 800;
}

.content-scroll {
  height: calc(100vh - 255rpx);
}

.tab-panel {
  padding: 10rpx 24rpx 56rpx;
}

.section-title {
  margin: 28rpx 0 18rpx;
  color: #2f1d15;
  font-size: 32rpx;
  font-weight: 900;
}

.section-title.no-margin {
  margin: 0;
}

.task-title-row {
  margin: 28rpx 0 18rpx;
}

.task-title-row .small-btn {
  min-width: 116rpx;
}

.task-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.settings-menu { padding-top: 28rpx; }

.settings-menu-list {
  margin-top: 22rpx;
  border-top: 1rpx solid rgba(58, 36, 24, 0.1);
  background: #ffffff;
}

.settings-menu-item {
  min-height: 78rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(58, 36, 24, 0.1);
  color: #3a2418;
  font-size: 25rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.settings-menu-item-hover { background: #fff0da; }

.settings-menu-arrow {
  color: #b7773d;
  font-size: 34rpx;
  font-weight: 400;
}

.section-tip,
.top-tip,
.card-sub,
.row-sub,
.agent-sub,
.modal-note,
.log-time {
  color: rgba(58, 36, 24, 0.58);
  font-size: 22rpx;
  line-height: 1.45;
}

.top-tip {
  margin-top: -6rpx;
}

.section-head,
.card-top,
.compact-row,
.form-line,
.log-row,
.job-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.agent-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  padding: 26rpx;
  border-radius: 8rpx;
  color: #fffaf4;
  background: #594031;
}

.agent-banner.online { background: #304937; }
.agent-banner.offline { background: #7c4030; }

.agent-title {
  font-size: 30rpx;
  font-weight: 900;
}

.agent-banner .agent-sub { color: rgba(255, 250, 244, 0.75); }

.outline-btn {
  flex-shrink: 0;
  padding: 15rpx 18rpx;
  border: 1rpx solid rgba(255, 250, 244, 0.6);
  border-radius: 8rpx;
  font-size: 22rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.metric-card,
.data-card,
.compact-row,
.alert-box,
.log-row {
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(58, 36, 24, 0.07);
}

.metric-card {
  min-height: 118rpx;
  padding: 20rpx;
  border-radius: 8rpx;
}

.metric-card.clickable { transition: transform 120ms ease, box-shadow 120ms ease; }
.metric-card-hover { transform: scale(0.98); box-shadow: 0 4rpx 12rpx rgba(58, 36, 24, 0.12); }

.metric-card.warning { border-left: 8rpx solid #e99b28; }
.metric-card.error { border-left: 8rpx solid #ca4a35; }

.metric-num {
  display: block;
  color: #2f1d15;
  font-size: 42rpx;
  font-weight: 900;
}

.metric-label {
  display: block;
  margin-top: 8rpx;
  color: #84685b;
  font-size: 22rpx;
}

.card-title,
.row-title {
  color: #2f1d15;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.compact-row,
.data-card,
.alert-box,
.log-row {
  margin-bottom: 16rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.status-pill {
  flex-shrink: 0;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #866851;
  background: #fff0da;
  font-size: 20rpx;
  font-weight: 800;
}

.status-pill.online,
.status-pill.printed { color: #27653c; background: #e4f4e8; }
.status-pill.offline,
.status-pill.failed,
.status-pill.cancelled { color: #a6382b; background: #fce3de; }
.status-pill.queued,
.status-pill.claimed,
.status-pill.sending,
.status-pill.unassigned { color: #9b641b; background: #fff0d4; }

.detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 18rpx;
  margin-top: 16rpx;
  color: #7f6254;
  font-size: 21rpx;
}

.error-line {
  margin-top: 14rpx;
  padding: 12rpx;
  border-radius: 6rpx;
  color: #a6382b;
  background: #fce3de;
  font-size: 22rpx;
  line-height: 1.4;
}

.card-actions,
.template-actions,
.field-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.small-btn,
.primary-small,
.primary-btn,
.search-btn,
.filter-toggle {
  min-height: 54rpx;
  padding: 0 16rpx;
  border-radius: 7rpx;
  line-height: 54rpx;
  font-size: 22rpx;
  box-sizing: border-box;
}

.small-btn { color: #8a5e37; background: #fff0da; }
.small-btn.strong,
.primary-small,
.primary-btn,
.search-btn { color: #fffaf4; background: #e54a1d; }
.small-btn.danger { color: #a6382b; background: #fce3de; }

.primary-btn { flex-shrink: 0; min-width: 90rpx; }

.alert-box { border-left: 8rpx solid #e99b28; }
.usb-box { border-left-color: #4b8461; }
.alert-title { color: #7c4814; font-size: 27rpx; font-weight: 900; }
.alert-line { margin-top: 12rpx; color: #805c45; font-size: 22rpx; }
.text-link { display: inline-block; margin-top: 14rpx; color: #d5481f; font-size: 23rpx; }

.filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.job-card.selected {
  background: #FFF4E2;
  box-shadow: 0 10rpx 24rpx rgba(138, 94, 55, 0.2);
}

.job-filter-row { position: relative; z-index: 12; }
.log-device-row { position: relative; z-index: 12; }

.job-filter-select {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.job-filter-select.open { z-index: 20; }
.log-device-select { flex: 1; max-width: 360rpx; }

.job-filter-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  min-width: 0;
}

.job-filter-trigger text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-filter-arrow {
  flex-shrink: 0;
  color: rgba(58, 36, 24, 0.45);
  font-size: 22rpx;
  font-weight: 900;
  transition: transform 0.16s ease;
}

.job-filter-arrow.open { transform: rotate(180deg); }

.job-filter-dropdown {
  position: absolute;
  top: calc(100% + 6rpx);
  left: 0;
  right: 0;
  max-height: 300rpx;
  border: 1rpx solid rgba(154, 100, 42, 0.18);
  border-radius: 8rpx;
  background: #fffdf9;
  box-shadow: 0 12rpx 28rpx rgba(58, 36, 24, 0.15);
  overflow: hidden;
}

.job-filter-option {
  min-height: 62rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  color: #5f4030;
  border-bottom: 1rpx solid rgba(58, 36, 24, 0.07);
  font-size: 22rpx;
  box-sizing: border-box;
}

.job-filter-option:last-child { border-bottom: 0; }
.job-filter-option.active { color: #8a5526; background: #fff0da; font-weight: 800; }

.search-input,
.filter-picker,
.inline-input {
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 7rpx;
  color: #3a2418;
  background: #ffffff;
  font-size: 23rpx;
  line-height: 64rpx;
  box-sizing: border-box;
}

.search-input { flex: 1; min-width: 0; }
.filter-picker { min-width: 160rpx; max-width: 260rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.filter-toggle { color: #8a5e37; background: #fff0da; white-space: nowrap; }
.filter-toggle.on { color: #fffaf4; background: #a54b2c; }

.template-selector-row {
  position: relative;
  z-index: 12;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: -2rpx 0 12rpx;
}

.template-selector-label {
  flex-shrink: 0;
  color: #7f6254;
  font-size: 22rpx;
  font-weight: 800;
}

.template-select {
  flex: 0 1 340rpx;
  max-width: 340rpx;
}

.template-select .filter-picker {
  width: 100%;
  max-width: none;
}

.template-dropdown { max-height: 360rpx; }

.template-option {
  justify-content: space-between;
  gap: 16rpx;
}

.template-editor-scroll {
  width: 100%;
  margin-top: 8rpx;
  white-space: normal;
}

.template-config-card { margin-top: 18rpx; padding: 10rpx 16rpx; }

.template-actions-bottom {
  justify-content: flex-end;
  margin: 18rpx 0 0;
}

.three-column-editor {
  display: grid;
  grid-template-columns: 150rpx minmax(215rpx, 1fr) 205rpx;
  gap: 12rpx;
  min-width: 594rpx;
  margin-top: 0;
}

.editor-column {
  min-height: 520rpx;
  padding: 14rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(58, 36, 24, 0.07);
  box-sizing: border-box;
}

.editor-label,
.subhead {
  margin-bottom: 16rpx;
  color: #5d3523;
  font-size: 24rpx;
  font-weight: 900;
}

.field-option {
  margin-bottom: 10rpx;
  padding: 11rpx 10rpx;
  border-radius: 6rpx;
  color: #80573d;
  background: #fff5e8;
  font-size: 21rpx;
}

.receipt-preview {
  min-height: 440rpx;
  padding: 24rpx 18rpx;
  color: #16100d;
  background: #fffdf9;
  box-shadow: inset 0 0 0 1rpx rgba(58, 36, 24, 0.08);
  font-family: monospace;
  box-sizing: border-box;
}

.preview-line {
  min-height: 26rpx;
  padding: 5rpx 6rpx;
  white-space: pre-wrap;
  word-break: break-all;
  font-size: 21rpx;
}

.preview-line.selected { outline: 2rpx solid #e54a1d; background: #fff0da; }
.preview-line.bold { font-weight: 900; }
.preview-line.inverse { color: #fff; background: #2f1d15; }
.preview-line.size-small { font-size: 17rpx; }
.preview-line.size-medium { font-size: 25rpx; }
.preview-line.size-large { font-size: 29rpx; }
.preview-line.size-xlarge { font-size: 34rpx; }
.preview-line.align-center { text-align: center; }
.preview-line.align-right { text-align: right; }
.cashier-preview-row { display: flex; align-items: flex-start; width: 100%; min-height: 30rpx; line-height: 1.55; text-align: left; }
.cashier-preview-row.header { margin-bottom: 4rpx; font-weight: 900; }
.cashier-preview-dish { flex: 0 0 45%; min-width: 0; padding-right: 6rpx; word-break: break-all; box-sizing: border-box; }
.cashier-preview-count { flex: 0 0 25%; text-align: center; }
.cashier-preview-subtotal { flex: 1; text-align: right; }
.cashier-summary-row { display: flex; justify-content: space-between; width: 100%; min-height: 30rpx; line-height: 1.55; text-align: left; }
.cashier-summary-row text:last-child { text-align: right; }
.preview-divider { height: 1rpx; margin: 9rpx 0; background: #2f1d15; }

.setting-row,
.capability {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 60rpx;
  padding: 6rpx 0;
  border-bottom: 1rpx solid rgba(58, 36, 24, 0.08);
  color: #6d5142;
  font-size: 21rpx;
}

.setting-row input { width: 130rpx; padding: 8rpx; color: #3a2418; background: #fff5e8; border-radius: 5rpx; font-size: 21rpx; }
.field-value { max-width: 130rpx; overflow: hidden; color: #8a5e37; font-size: 21rpx; font-weight: 800; text-align: right; text-overflow: ellipsis; white-space: nowrap; }

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.form-item { margin-bottom: 18rpx; }
.form-item.full { grid-column: 1 / -1; }
.form-item > text { display: block; margin-bottom: 9rpx; color: #6d5142; font-size: 22rpx; font-weight: 800; }
.form-item input,
.picker-value { min-height: 64rpx; padding: 0 14rpx; border-radius: 7rpx; color: #3a2418; background: #fff; font-size: 23rpx; line-height: 64rpx; box-sizing: border-box; }
.picker-value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.segmented { display: flex; overflow: hidden; border-radius: 7rpx; background: #fff0da; }
.segment { flex: 1; min-height: 58rpx; color: #86604b; font-size: 22rpx; line-height: 58rpx; text-align: center; }
.segment.active { color: #fffaf4; background: #e54a1d; }

.subhead { margin-top: 8rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(58, 36, 24, 0.1); }
.capability-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24rpx; }

.form-line { min-height: 72rpx; padding: 8rpx 0; border-bottom: 1rpx solid rgba(58, 36, 24, 0.08); color: #6d5142; font-size: 23rpx; }
.form-line .picker-value { min-width: 250rpx; text-align: right; background: transparent; }
.template-config-card .form-line { min-height: 50rpx; padding: 2rpx 0; font-size: 18rpx; }
.template-config-card .picker-value { width: 150rpx; min-width: 150rpx; min-height: 46rpx; padding: 0 8rpx; font-size: 18rpx; line-height: 46rpx; }
.inline-input { width: 100rpx; text-align: center; }

.range-tabs { display: flex; gap: 8rpx; }
.range-tab { padding: 11rpx 12rpx; border-radius: 6rpx; color: #80573d; background: #fff0da; font-size: 21rpx; }
.range-tab.active { color: #fffaf4; background: #a54b2c; }
.log-row { align-items: flex-start; }
.log-dot { width: 14rpx; height: 14rpx; margin-top: 9rpx; border-radius: 50%; background: #3d8854; }
.log-dot.error { background: #c94132; }
.log-main { flex: 1; min-width: 0; }
.log-time { max-width: 155rpx; text-align: right; }

.empty-state { padding: 100rpx 20rpx; color: #a28a7d; text-align: center; font-size: 25rpx; }
.load-more { margin: 20rpx 0 8rpx; padding: 18rpx; border: 1rpx solid #edc3a8; border-radius: 7rpx; color: #b34623; background: #fff5e8; font-size: 24rpx; font-weight: 800; text-align: center; }

.modal-mask {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background: rgba(29, 18, 13, 0.55);
  box-sizing: border-box;
}

.modal-card {
  width: 100%;
  max-width: 900rpx;
  max-height: 90vh;
  overflow: hidden;
  border-radius: 10rpx;
  background: #fff7ec;
}

.modal-card.short { max-width: 660rpx; }
.printer-more-wrap { position: relative; z-index: 3; }
.printer-more-dropdown { position: absolute; top: calc(100% + 6rpx); right: 0; z-index: 20; width: 200rpx; padding: 6rpx; border: 1rpx solid rgba(154, 100, 42, 0.18); border-radius: 8rpx; background: #fffdf9; box-shadow: 0 12rpx 28rpx rgba(58, 36, 24, 0.16); box-sizing: border-box; }
.printer-more-option { min-height: 48rpx; padding: 0 12rpx; display: flex; align-items: center; border-radius: 6rpx; color: #5f4030; font-size: 20rpx; font-weight: 800; box-sizing: border-box; }
.printer-more-option:active { background: #fff0da; }
.printer-more-option.danger { color: #a6382b; }
.registration-card { max-width: 620rpx; }
.modal-title { padding: 26rpx 28rpx 18rpx; color: #2f1d15; font-size: 32rpx; font-weight: 900; }
.modal-body { max-height: 64vh; padding: 0 28rpx 24rpx; box-sizing: border-box; }
.modal-footer { display: flex; gap: 14rpx; padding: 18rpx 28rpx 28rpx; border-top: 1rpx solid rgba(58, 36, 24, 0.1); }
.modal-btn { flex: 1; min-height: 72rpx; border-radius: 8rpx; font-size: 26rpx; font-weight: 900; line-height: 72rpx; text-align: center; }
.modal-btn.cancel { color: #785d50; background: #fff0da; }
.modal-btn.confirm { color: #fffaf4; background: #e54a1d; }
.modal-note { margin-bottom: 22rpx; padding: 16rpx; border-radius: 7rpx; background: #fff0da; }
.code-line { margin-top: 16rpx; color: #674834; font-size: 22rpx; word-break: break-all; }
.registration-code { margin-top: 14rpx; padding: 18rpx; border-radius: 7rpx; color: #fffaf4; background: #2f1d15; font-family: monospace; font-size: 29rpx; font-weight: 900; letter-spacing: 1rpx; word-break: break-all; }
.job-preview { min-height: 300rpx; }
.job-meta { margin-bottom: 16rpx; color: #6d5142; font-size: 23rpx; }

.job-detail-card {
  max-height: calc(100vh - 60rpx);
}

.job-detail-body {
  height: calc(90vh - 240rpx);
  max-height: none;
}

.job-detail-footer {
  flex-shrink: 0;
  flex-wrap: wrap;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.job-detail-footer .modal-btn {
  min-width: 0;
  padding: 0 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.template-history-card { max-width: 620rpx; }
.template-history-head { display: flex; align-items: center; justify-content: space-between; padding-right: 28rpx; }
.template-history-head .modal-title { padding-right: 12rpx; }
.template-history-delete { min-width: 72rpx; color: #a6382b; font-size: 22rpx; font-weight: 900; text-align: right; }
.template-history-body { min-height: 180rpx; max-height: 50vh; }
.template-history-row { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; min-height: 74rpx; padding: 0 8rpx; border: 1rpx solid transparent; border-bottom-color: rgba(58, 36, 24, 0.1); color: #513325; box-sizing: border-box; }
.template-history-row.selected { border-color: #8a5e37; background: #fff0da; box-shadow: 0 5rpx 14rpx rgba(58, 36, 24, 0.17); }
.template-history-version { margin-right: 12rpx; font-size: 25rpx; font-weight: 900; }
.template-history-reason, .template-history-time { color: #8a6a58; font-size: 20rpx; }
.template-history-time { flex-shrink: 0; }
.template-history-empty { padding: 48rpx 0; }

/* The print center is used on the merchant tablet in landscape mode. */
.print-workspace {
  height: calc(100vh - 48rpx);
  display: flex;
  min-width: 0;
  min-height: 0;
}

.tab-scroll {
  width: 142rpx;
  height: 100%;
  flex: 0 0 142rpx;
  box-sizing: border-box;
  border-right: 1rpx solid rgba(58, 36, 24, 0.1);
}

.print-content {
  height: 100%;
  flex: 1;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.settings-detail-mode .print-content {
  width: 100%;
}

.settings-detail-mode .print-workspace {
  height: 100vh;
}

.content-scroll {
  flex: 1;
  min-height: 0;
  height: auto;
}

.tabs {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  padding: 12rpx 10rpx;
}

.tab {
  display: block;
  padding: 11rpx 10rpx;
  border-radius: 6rpx;
  font-size: 13rpx;
  text-align: center;
}

.tab-panel {
  padding: 12rpx 18rpx 28rpx;
}

@media (orientation: landscape) {
  .metric-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .metric-card { min-height: 92rpx; }
}

/* rpx grows with the width of a tablet. Keep the operational controls at a
   stable physical size, otherwise horizontal iPads make them oversized. */
@media (min-width: 700px) {
  .page-head {
    height: 38px;
    padding: 0 14px;
  }

  .page-title { font-size: 16px; }

  .print-workspace {
    height: calc(100vh - 38px);
  }

  .tab-scroll {
    width: 108px;
    flex-basis: 108px;
  }

  .tabs {
    gap: 6px;
    padding: 8px;
  }

  .tab {
    padding: 8px 6px;
    border-radius: 5px;
    font-size: 12px;
  }

  .tab-panel {
    padding: 10px 14px 24px;
  }

  .section-title,
  .task-title-row {
    margin-top: 16px;
    margin-bottom: 12px;
  }

  .section-title { font-size: 18px; }
  .section-tip,
  .top-tip,
  .card-sub,
  .row-sub,
  .agent-sub,
  .modal-note,
  .log-time { font-size: 12px; }

  .metric-grid { gap: 10px; margin-top: 12px; }
  .metric-card { min-height: 78px; padding: 14px; }
  .metric-num { font-size: 28px; }
  .metric-label { margin-top: 4px; font-size: 12px; }

  .agent-banner { gap: 14px; padding: 14px; }
  .agent-title { font-size: 18px; }
  .outline-btn { padding: 8px 10px; border-radius: 5px; font-size: 12px; }

  .compact-row,
  .data-card,
  .alert-box,
  .log-row { margin-bottom: 10px; padding: 14px; }

  .card-title,
  .row-title { font-size: 16px; }
  .status-pill { padding: 4px 8px; font-size: 11px; }
  .detail-grid { gap: 6px 12px; margin-top: 10px; font-size: 12px; }

  .small-btn,
  .primary-small,
  .primary-btn,
  .search-btn,
  .filter-toggle {
    min-height: 30px;
    padding: 0 10px;
    border-radius: 5px;
    font-size: 12px;
    line-height: 30px;
  }

  .primary-btn { min-width: 58px; }
  .card-actions,
  .template-actions,
  .field-actions { gap: 7px; margin-top: 12px; }

  .filter-row { gap: 8px; margin-bottom: 9px; }
  .search-input,
  .filter-picker,
  .inline-input {
    height: 34px;
    padding: 0 10px;
    border-radius: 5px;
    font-size: 12px;
    line-height: 34px;
  }

  .filter-picker { min-width: 108px; max-width: 190px; }
  .job-filter-option { min-height: 34px; padding: 0 10px; font-size: 12px; }
  .job-filter-dropdown { max-height: 210px; }
  .job-filter-arrow { font-size: 13px; }

  .settings-menu { padding-top: 16px; }
  .settings-menu-list { margin-top: 12px; }
  .settings-menu-item { min-height: 48px; padding: 0 14px; font-size: 14px; }
  .settings-menu-arrow { font-size: 22px; }
  .task-actions { gap: 6px; }
  .task-title-row .small-btn { min-width: 0; }

  .error-line {
    margin-top: 8px;
    padding: 8px;
    border-radius: 5px;
    font-size: 12px;
    line-height: 1.4;
  }

  .modal-mask { padding: 16px; }
  .modal-card {
    max-width: 820px;
    max-height: calc(100vh - 32px);
    border-radius: 8px;
  }
  .modal-card.short { max-width: 520px; }
  .modal-title { padding: 16px 18px 10px; font-size: 18px; }
  .modal-body { max-height: 64vh; padding: 0 18px 16px; }
  .modal-footer { gap: 8px; padding: 12px 18px 16px; }
  .modal-btn { min-height: 34px; border-radius: 5px; font-size: 13px; line-height: 34px; }

  .job-detail-card {
    width: 500px;
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 32px);
  }

  .job-detail-body {
    height: calc(100vh - 142px);
    padding-bottom: 12px;
  }

  .job-meta { margin-bottom: 8px; font-size: 12px; }
  .job-preview { min-height: 0; padding: 10px; }
  .job-detail-card .preview-line { min-height: 16px; padding: 3px 4px; font-size: 11px; }
  .job-detail-card .preview-line.size-small { font-size: 10px; }
  .job-detail-card .preview-line.size-medium { font-size: 12px; }
  .job-detail-card .preview-line.size-large { font-size: 14px; }
  .job-detail-card .preview-line.size-xlarge { font-size: 16px; }
  .job-detail-footer { padding-bottom: calc(12px + env(safe-area-inset-bottom)); }
  .job-detail-footer .modal-btn { padding: 0 8px; }
}

@media (max-width: 540px) {
  .page-head { padding: 28rpx 22rpx; }
  .page-title { font-size: 38rpx; }
  .tab-panel { padding-left: 18rpx; padding-right: 18rpx; }
  .form-grid,
  .capability-list { grid-template-columns: 1fr; }
  .metric-grid { gap: 12rpx; }
  .metric-card { padding: 17rpx; }
  .filter-row { flex-wrap: wrap; }
  .search-input { min-width: 300rpx; }
  .three-column-editor { grid-template-columns: 150rpx 215rpx 205rpx; }
}
