page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #FFF7EC;
}

.settlement-page {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  color: #3A2418;
  background: #FFF7EC;
  box-sizing: border-box;
}

.settlement-head {
  height: 48rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(58, 36, 24, 0.1);
}

.settlement-title,
.detail-title {
  color: #3A2418;
  font-size: 17rpx;
  font-weight: 900;
}

.settlement-controls {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.date-label,
.date-picker,
.refresh-button {
  height: 26rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  font-size: 10rpx;
  font-weight: 800;
}

.date-label {
  color: #80614E;
}

.date-picker,
.refresh-button {
  justify-content: center;
  border: 1rpx solid rgba(58, 36, 24, 0.2);
  border-radius: 5rpx;
  background: #FFFFFF;
}

.date-picker {
  min-width: 122rpx;
  padding: 0 9rpx;
  color: #5A3928;
}

.refresh-button {
  min-width: 48rpx;
  padding: 0 10rpx;
  color: #6A4530;
}

.settlement-body {
  height: calc(100vh - 48rpx);
  padding: 14rpx 24rpx 20rpx;
  display: grid;
  grid-template-columns: minmax(220rpx, 0.78fr) minmax(0, 2.15fr);
  gap: 14rpx;
  box-sizing: border-box;
}

.record-panel,
.detail-panel {
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(58, 36, 24, 0.14);
  border-radius: 7rpx;
  background: #FFFFFF;
  box-shadow: 0 5rpx 12rpx rgba(74, 41, 22, 0.1);
}

.record-panel {
  display: flex;
  flex-direction: column;
}

.record-panel-head,
.detail-title {
  height: 42rpx;
  padding: 0 13rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(58, 36, 24, 0.1);
  color: #70472E;
  font-size: 11rpx;
  font-weight: 900;
}

.record-panel-head {
  justify-content: space-between;
  gap: 8rpx;
}

.date-hint {
  min-width: 0;
  overflow: hidden;
  color: #9B7B69;
  font-size: 8rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-list,
.detail-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.record-list {
  padding: 10rpx;
}

.record-card {
  margin-bottom: 8rpx;
  padding: 10rpx 11rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(58, 36, 24, 0.12);
  border-radius: 5rpx;
  background: #FFFDF8;
}

.record-card.selected {
  border-color: #9B5E25;
  background: #FFF0CF;
  box-shadow: 0 3rpx 9rpx rgba(126, 71, 27, 0.16);
}

.record-card-head,
.record-card-foot,
.order-group-head,
.bill-row,
.detail-meta-row,
.goods-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.record-table {
  min-width: 0;
  overflow: hidden;
  color: #3A2418;
  font-size: 12rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-time {
  flex: none;
  color: #977A68;
  font-size: 9rpx;
}

.record-card-foot {
  margin-top: 6rpx;
  color: #80614E;
  font-size: 9rpx;
}

.record-people {
  margin-left: 6rpx;
}

.record-money,
.receivable {
  color: #BF361E;
  font-weight: 900;
}

.truncated-note {
  padding: 6rpx 10rpx 8rpx;
  border-top: 1rpx solid rgba(58, 36, 24, 0.09);
  color: #9A642A;
  font-size: 8rpx;
}

.detail-panel {
  display: flex;
  flex-direction: column;
}

.detail-scroll {
  padding: 13rpx;
}

.detail-empty,
.panel-empty {
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9B7B69;
  font-size: 11rpx;
  text-align: center;
}

.detail-summary,
.bill-section {
  padding: 11rpx 12rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(58, 36, 24, 0.12);
  border-radius: 5rpx;
  background: #FFFDF8;
}

.detail-summary-main {
  margin-bottom: 8rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10rpx;
}

.detail-table {
  min-width: 0;
  color: #3A2418;
  font-size: 15rpx;
  font-weight: 900;
}

.detail-scene {
  flex: none;
  color: #997047;
  font-size: 9rpx;
  font-weight: 800;
}

.detail-meta-row,
.bill-row {
  min-height: 20rpx;
  color: #7C5C49;
  font-size: 9rpx;
}

.bill-section {
  margin-top: 10rpx;
}

.bill-row.receivable {
  margin-top: 4rpx;
  padding-top: 7rpx;
  border-top: 1rpx solid rgba(58, 36, 24, 0.1);
  font-size: 11rpx;
}

.order-group {
  margin-top: 10rpx;
  overflow: hidden;
  border: 1rpx solid rgba(58, 36, 24, 0.12);
  border-radius: 5rpx;
}

.order-group-head {
  min-height: 30rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  color: #714A30;
  background: #FFF1D7;
  font-size: 10rpx;
  font-weight: 900;
}

.goods-row {
  min-height: 28rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-top: 1rpx solid rgba(58, 36, 24, 0.08);
  font-size: 9rpx;
}

.good-name {
  flex: 1;
  min-width: 0;
  color: #3A2418;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.good-count {
  width: 44rpx;
  color: #7C5C49;
  text-align: center;
}

.good-money {
  width: 66rpx;
  color: #7A4026;
  text-align: right;
  font-weight: 800;
}

.order-group-actions,
.settlement-edit-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.edit-action-link {
  color: #A65A1B;
  font-size: 9rpx;
  white-space: nowrap;
}

.danger-text,
.edit-action-button.danger {
  color: #C9341C;
}

.settlement-edit-actions {
  margin-top: 8rpx;
  justify-content: flex-end;
}

.edit-action-button {
  padding: 5rpx 9rpx;
  border-radius: 5rpx;
  background: #FFF0CF;
  color: #70472E;
  font-size: 9rpx;
  font-weight: 800;
  white-space: nowrap;
}

.add-dish-form {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 6rpx;
  padding: 8rpx;
  border-top: 1rpx solid rgba(58, 36, 24, 0.08);
}

.add-dish-search-row {
  display: flex;
  align-items: center;
  gap: 7rpx;
}

.add-dish-form input {
  min-width: 0;
  height: 26rpx;
  padding: 0 6rpx;
  border: 1rpx solid rgba(58, 36, 24, 0.2);
  border-radius: 4rpx;
  font-size: 9rpx;
}

.add-dish-search-input {
  flex: 1;
}

.add-dish-count-input {
  width: 54rpx;
}

.add-dish-results {
  max-height: 140rpx;
  overflow-y: auto;
  border: 1rpx solid rgba(58, 36, 24, 0.12);
  border-radius: 4rpx;
}

.add-dish-result {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 8rpx;
  border-bottom: 1rpx solid rgba(58, 36, 24, 0.08);
  color: #70472E;
  font-size: 9rpx;
}

.add-dish-selected,
.add-dish-hint {
  color: #806F60;
  font-size: 8rpx;
}

.add-dish-selected {
  color: #A65A1B;
}

.edit-action-button.disabled {
  opacity: 0.55;
}

.settlement-error {
  position: fixed;
  left: 24rpx;
  bottom: 14rpx;
  z-index: 3;
  max-width: 70vw;
  color: #C9341C;
  font-size: 9rpx;
}

@media (max-width: 600px) {
  .settlement-head {
    padding: 0 14rpx;
  }

  .settlement-body {
    padding: 10rpx 14rpx 16rpx;
    grid-template-columns: minmax(176rpx, 0.78fr) minmax(0, 1.8fr);
    gap: 10rpx;
  }

  .date-label {
    display: none;
  }

  .date-picker {
    min-width: 114rpx;
  }

  .record-panel-head,
  .detail-title {
    padding: 0 10rpx;
  }

  .record-card {
    padding: 9rpx;
  }

  .detail-scroll {
    padding: 10rpx;
  }
}
