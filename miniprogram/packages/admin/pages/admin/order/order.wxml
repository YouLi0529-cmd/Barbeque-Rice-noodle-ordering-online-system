<view class="settlement-page" capture-bind:tap="onAdminTap">
  <view class="settlement-head">
    <view class="settlement-title">{{ui.title}}</view>
    <view class="settlement-controls">
      <view class="date-label">{{ui.date}}</view>
      <picker mode="date" value="{{selectedDate}}" start="{{minDate}}" end="{{maxDate}}" bindchange="onDateChange">
        <view class="date-picker">{{selectedDate}}</view>
      </picker>
      <view class="refresh-button" bindtap="refreshRecords">{{refreshing ? '...' : ui.refresh}}</view>
    </view>
  </view>

  <view class="settlement-body">
    <view class="record-panel">
      <view class="record-panel-head">
        <view>{{records.length}}{{ui.recordCount}}</view>
      </view>
      <scroll-view class="record-list" scroll-y enable-flex>
        <view class="panel-empty" wx:if="{{loading}}">...</view>
        <view class="panel-empty" wx:elif="{{records.length === 0}}">{{ui.empty}}</view>
        <block wx:else>
          <view
            wx:for="{{records}}"
            wx:key="id"
            class="record-card {{selectedRecordId === item.id ? 'selected' : ''}}"
            data-id="{{item.id}}"
            bindtap="selectRecord">
            <view class="record-card-head">
              <view class="record-table">{{item.tableText}}</view>
              <view class="record-time">{{item.paidTimeText}}</view>
            </view>
            <view class="record-card-foot">
              <view>{{item.sceneText}}<text class="record-people">{{item.peopleText}}</text></view>
              <view class="record-money">¥{{item.receivableText}}</view>
            </view>
          </view>
        </block>
      </scroll-view>
      <view class="truncated-note" wx:if="{{isTruncated}}">{{ui.moreHint}}</view>
    </view>

    <view class="detail-panel">
      <view class="detail-title">{{ui.detailTitle}}</view>
      <view class="detail-empty" wx:if="{{detailLoading}}">...</view>
      <view class="detail-empty" wx:elif="{{!detail}}">{{ui.selectTip}}</view>
      <scroll-view class="detail-scroll" wx:else scroll-y enable-flex>
        <view class="detail-summary">
          <view class="detail-summary-main">
            <view class="detail-table">{{detail.tableText}}</view>
            <view class="detail-scene">{{detail.sceneText}}</view>
          </view>
          <view class="detail-meta-row"><text>{{ui.settledAt}}</text><text>{{detail.paidTimeText}}</text></view>
          <view class="detail-meta-row"><text>{{ui.people}}</text><text>{{detail.peopleText}}</text></view>
          <view class="detail-meta-row"><text>{{ui.payment}}</text><text>{{detail.paymentText}}</text></view>
        </view>

        <view class="bill-section">
          <view class="bill-row"><text>{{ui.total}}</text><text>¥{{detail.totalText}}</text></view>
          <view class="bill-row" wx:if="{{detail.discountText}}"><text>{{ui.discount}}</text><text>{{detail.discountText}}</text></view>
          <view class="bill-row" wx:if="{{detail.directReduceText}}"><text>{{ui.directReduce}}</text><text>-¥{{detail.directReduceText}}</text></view>
          <view class="bill-row receivable"><text>{{ui.receivable}}</text><text>¥{{detail.receivableText}}</text></view>
        </view>

        <view class="order-group" wx:for="{{detail.orderGroups}}" wx:key="id">
          <view class="order-group-head">
            <view>{{item.title}}</view>
            <view>¥{{item.totalText}}</view>
          </view>
          <view class="goods-row" wx:for="{{item.goods}}" wx:key="index" wx:for-item="good">
            <view class="good-name">{{good.dishName}}</view>
            <view class="good-count">x{{good.count}}</view>
            <view class="good-money">¥{{good.subtotalText}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="settlement-error" wx:if="{{loadError}}">{{loadError}}</view>
  <admin-info-center id="admin-info-center"></admin-info-center>
</view>
