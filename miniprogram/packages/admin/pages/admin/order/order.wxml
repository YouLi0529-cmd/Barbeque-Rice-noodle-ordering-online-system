<view class="settlement-page" capture-bind:tap="onAdminTap">
  <view class="settlement-head">
    <view class="settlement-title">{{ui.title}}</view>
    <view class="settlement-controls">
      <view class="date-label">{{ui.date}}</view>
      <picker mode="date" value="{{selectedDate}}" start="{{minDate}}" end="{{maxDate}}" bindchange="onDateChange">
        <view class="date-picker">{{selectedDate}}</view>
      </picker>
      <view class="refresh-button" bindtap="refreshRecords">{{refreshing ? '...' : ui.refresh}}</view>
    </view>
  </view>

  <view class="settlement-body">
    <view class="record-panel">
      <view class="record-panel-head">
        <view>{{records.length}}{{ui.recordCount}}</view>
      </view>
      <scroll-view class="record-list" scroll-y enable-flex>
        <view class="panel-empty" wx:if="{{loading}}">...</view>
        <view class="panel-empty" wx:elif="{{records.length === 0}}">{{ui.empty}}</view>
        <block wx:else>
          <view
            wx:for="{{records}}"
            wx:key="id"
            class="record-card {{selectedRecordId === item.id ? 'selected' : ''}}"
            data-id="{{item.id}}"
            bindtap="selectRecord">
            <view class="record-card-head">
              <view class="record-table">{{item.tableText}}</view>
              <view class="record-time">{{item.paidTimeText}}</view>
            </view>
            <view class="record-card-foot">
              <view>{{item.sceneText}}<text class="record-people">{{item.peopleText}}</text></view>
              <view class="record-money">¥{{item.receivableText}}</view>
            </view>
          </view>
        </block>
      </scroll-view>
      <view class="truncated-note" wx:if="{{isTruncated}}">{{ui.moreHint}}</view>
    </view>

    <view class="detail-panel">
      <view class="detail-title">{{ui.detailTitle}}</view>
      <view class="detail-empty" wx:if="{{detailLoading}}">...</view>
      <view class="detail-empty" wx:elif="{{!detail}}">{{ui.selectTip}}</view>
      <scroll-view class="detail-scroll" wx:else scroll-y enable-flex>
        <view class="detail-summary">
          <view class="detail-summary-main">
            <view class="detail-table">{{detail.tableText}}</view>
            <view class="detail-scene">{{detail.sceneText}}</view>
          </view>
          <view class="detail-meta-row"><text>{{ui.settledAt}}</text><text>{{detail.paidTimeText}}</text></view>
          <view class="detail-meta-row"><text>{{ui.people}}</text><text>{{detail.peopleText}}</text></view>
          <view class="detail-meta-row editable-meta payment-selector" bindtap="togglePaymentPicker">
            <text>{{ui.payment}}</text>
            <view class="editable-meta-value">
              <text>{{detail.paymentText}}</text>
              <text class="editable-meta-mark">{{ui.edit}}</text>
              <text class="payment-picker-arrow {{showPaymentPicker ? 'open' : ''}}">v</text>
            </view>
            <view class="settlement-payment-dropdown" wx:if="{{showPaymentPicker}}" catchtap="stopSettlementPickerTap">
              <view
                wx:for="{{paymentOptions}}"
                wx:key="value"
                class="settlement-payment-option {{item.value === detail.paymentMethod ? 'selected' : ''}}"
                data-value="{{item.value}}"
                catchtap="selectSettlementPayment">
                {{item.label}}
              </view>
            </view>
          </view>
          <view class="settlement-edit-actions"><view class="edit-action-button danger" bindtap="deleteSettlementRecord">永久删除整笔结算</view></view>
        </view>

        <view class="bill-section">
          <view class="bill-row"><text>{{ui.total}}</text><text>¥{{detail.totalText}}</text></view>
          <view class="bill-row" wx:if="{{detail.discountText}}"><text>{{ui.discount}}</text><text>{{detail.discountText}}</text></view>
          <view class="bill-row" wx:if="{{detail.directReduceText}}"><text>{{ui.directReduce}}</text><text>-¥{{detail.directReduceText}}</text></view>
          <view class="bill-row receivable editable-bill-row" bindtap="openSettlementAmountModal">
            <text>{{ui.receivable}}</text>
            <view class="editable-bill-value"><text>¥{{detail.receivableText}}</text><text class="editable-meta-mark">{{ui.edit}}</text></view>
          </view>
        </view>

        <view class="order-group" wx:for="{{detail.orderGroups}}" wx:key="id">
          <view class="order-group-head">
            <view>{{item.title}}</view>
            <view class="order-group-actions"><text>¥{{item.totalText}}</text><text class="edit-action-link danger-text" data-id="{{item.id}}" catchtap="deleteSettlementOrder">删除订单</text><text class="edit-action-link" data-id="{{item.id}}" catchtap="toggleAddDish">加菜</text></view>
          </view>
          <view class="goods-row" wx:for="{{item.goods}}" wx:key="index" wx:for-item="good">
            <view class="good-name">{{good.dishName}}</view>
            <view class="good-count">x{{good.count}}</view>
            <view class="good-money">¥{{good.subtotalText}}</view>
            <text class="edit-action-link danger-text" data-order-id="{{item.id}}" data-goods-index="{{good.goodsIndex}}" catchtap="deleteSettlementDish">删除</text>
          </view>
          <view wx:if="{{addingToOrderId === item.id}}" class="add-dish-form">
            <view class="add-dish-search-row">
              <input class="add-dish-search-input" placeholder="&#x641c;&#x7d22;&#x73b0;&#x6709;&#x83dc;&#x5355;&#x83dc;&#x54c1;" value="{{addDishForm.keyword}}" data-key="keyword" bindinput="onAddDishInput" />
              <input class="add-dish-count-input" type="number" placeholder="&#x6570;&#x91cf;" value="{{addDishForm.count}}" data-key="count" bindinput="onAddDishInput" />
            </view>
            <view class="add-dish-hint" wx:if="{{addDishSearching}}">&#x6b63;&#x5728;&#x641c;&#x7d22;&#x83dc;&#x5355;...</view>
            <view class="add-dish-results" wx:if="{{addDishResults.length}}">
              <view class="add-dish-result" wx:for="{{addDishResults}}" wx:key="_id" data-id="{{item._id}}" catchtap="selectSettlementDish">
                <text>{{item.name}}</text><text>RMB {{item.price}}</text>
              </view>
            </view>
            <view class="add-dish-selected" wx:if="{{addDishForm.selectedDish}}">&#x5df2;&#x9009;: {{addDishForm.selectedDish.name}} | &#x83dc;&#x5355;&#x4ef7; RMB {{addDishForm.selectedDish.price}}</view>
            <view class="add-dish-hint" wx:if="{{!addDishSearching && addDishForm.keyword && !addDishResults.length && !addDishForm.selectedDish}}">&#x6ca1;&#x6709;&#x627e;&#x5230;&#x53ef;&#x7528;&#x83dc;&#x54c1;</view>
            <view class="add-dish-hint">&#x52a0;&#x83dc;&#x6309;&#x5f53;&#x524d;&#x83dc;&#x5355;&#x57fa;&#x7840;&#x4ef7;&#x683c;&#x8ba1;&#x4ef7;&#x3002;</view>
            <view class="edit-action-button {{!addDishForm.dishId ? 'disabled' : ''}}" data-id="{{item.id}}" bindtap="addSettlementDish">&#x786e;&#x8ba4;&#x52a0;&#x83dc;</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="settlement-error" wx:if="{{loadError}}">{{loadError}}</view>
  <view class="settlement-modal-mask" wx:if="{{showAmountModal}}" catchtap="closeSettlementAmountModal">
    <view class="settlement-amount-modal" catchtap="stopSettlementAmountModalTap">
      <view class="settlement-amount-title">{{ui.editReceivable}}</view>
      <view class="settlement-amount-hint">{{ui.amountHint}}</view>
      <input class="settlement-amount-input" type="digit" value="{{amountInput}}" focus="{{showAmountModal}}" bindinput="onSettlementAmountInput" bindconfirm="saveSettlementAmount" />
      <view class="settlement-amount-actions">
        <view class="settlement-modal-button cancel" bindtap="closeSettlementAmountModal">{{ui.cancel}}</view>
        <view class="settlement-modal-button confirm" bindtap="saveSettlementAmount">{{ui.confirm}}</view>
      </view>
    </view>
  </view>
  <admin-info-center id="admin-info-center"></admin-info-center>
</view>
